{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/innovation-ar-resource-platform/resource-descriptor-v1.json",
  "title": "resource.json v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "defaultVariant": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "rotation": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "scale": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "position",
        "rotation",
        "scale"
      ]
    },
    "settings": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "poster": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "audio": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "audioPosition": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "preview": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "enum": [
              "4dv-compressed-ply"
            ]
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "startSeconds": {
                  "type": "number",
                  "minimum": 0
                },
                "durationSeconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "path",
                "startSeconds",
                "durationSeconds"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "name",
          "format",
          "segments"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "formatVersion",
    "defaultVariant",
    "transform",
    "settings",
    "variants"
  ]
}