{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/utopia/runtime-manifest-v1.json",
  "title": "Runtime manifest (historical candidate)",
  "description": "Historical static candidate material from the superseded marker/day-night design. Not the current contract and no longer generated; see openapi.yaml and resource-descriptor.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "sceneId": {
      "type": "string",
      "format": "uuid"
    },
    "versionId": {
      "type": "string",
      "format": "uuid"
    },
    "versionNo": {
      "type": "integer",
      "minimum": 1
    },
    "variant": {
      "type": "string",
      "enum": [
        "DAY",
        "NIGHT"
      ]
    },
    "platform": {
      "type": "string",
      "enum": [
        "ANDROID",
        "IOS",
        "MINIPROGRAM"
      ]
    },
    "format": {
      "type": "string",
      "minLength": 1
    },
    "runtimeVersion": {
      "type": "string",
      "minLength": 1
    },
    "clientBuildRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "min"
      ]
    },
    "coordinateSystem": {
      "type": "string",
      "enum": [
        "scene-local-v1"
      ]
    },
    "markers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "markerId": {
            "type": "string",
            "format": "uuid"
          },
          "widthMeters": {
            "type": "number",
            "minimum": 1e-06
          },
          "heightMeters": {
            "type": "number",
            "minimum": 1e-06
          },
          "sceneFromMarker": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "position": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "rotation": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "required": [
              "position",
              "rotation"
            ]
          }
        },
        "required": [
          "markerId",
          "widthMeters",
          "heightMeters",
          "sceneFromMarker"
        ]
      },
      "minItems": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assetId": {
            "type": "string",
            "format": "uuid"
          },
          "logicalPath": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "assetId",
          "logicalPath",
          "sha256",
          "bytes",
          "url",
          "expiresAt"
        ]
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "playback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "LOCAL_INDEPENDENT"
          ]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "recoveryPolicy": {
          "type": "string",
          "enum": [
            "RESUME_LOCAL_TIME",
            "RESTART"
          ]
        }
      },
      "required": [
        "mode",
        "durationMs",
        "recoveryPolicy"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "sceneId",
    "versionId",
    "versionNo",
    "variant",
    "platform",
    "format",
    "runtimeVersion",
    "clientBuildRange",
    "coordinateSystem",
    "markers",
    "files",
    "entrypoint",
    "playback"
  ]
}