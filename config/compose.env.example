# Copy to config/compose.env (gitignored), generate private random values, never commit it.
AR_DATABASE_PASSWORD=
AR_TOKEN_SECRET=
AR_BOOTSTRAP_PASSWORD=
# Positive bytes: largest single file. Size it to the largest model file you will upload.
AR_STORAGE_MAX_BYTES=
# Per content version: file count (default 1000) and total bytes (default 4294967296 = 4 GiB).
AR_STORAGE_VERSION_MAX_FILES=1000
AR_STORAGE_VERSION_MAX_BYTES=4294967296
# Set to the host's actual LAN address to allow LAN clients; default remains loopback.
AR_BIND_ADDRESS=127.0.0.1
AR_HTTP_PORT=18081
