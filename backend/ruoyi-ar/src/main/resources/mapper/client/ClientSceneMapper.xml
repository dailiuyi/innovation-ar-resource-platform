<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ar.module.client.mapper.ClientSceneMapper">
    <resultMap id="clientScene" type="com.ruoyi.ar.module.client.model.ClientSceneRow" autoMapping="false">
        <constructor>
            <arg column="id" javaType="java.lang.String" />
            <arg column="name" javaType="java.lang.String" />
            <arg column="version_id" javaType="java.lang.String" />
            <arg column="version_no" javaType="_int" />
        </constructor>
    </resultMap>

    <resultMap id="clientFile" type="com.ruoyi.ar.module.client.model.ClientSceneFileRow" autoMapping="false">
        <constructor>
            <arg column="id" javaType="java.lang.String" />
            <arg column="relative_path" javaType="java.lang.String" />
            <arg column="expected_bytes" javaType="_long" />
            <arg column="expected_sha256" javaType="java.lang.String" />
        </constructor>
    </resultMap>

    <!-- 只展示启用、未删除、文件全部就绪且无删除意图的当前发布版本。 -->
    <sql id="visible">
        from ar_scene s join ar_scene_version v on v.id=s.published_version_id
        where s.enabled and s.deleted_at is null
          and not exists(select 1 from ar_version_file f where f.version_id=v.id and f.status&lt;&gt;'AVAILABLE')
          and not exists(select 1 from ar_version_deletion d where d.version_id=v.id and d.completed_at is null)
    </sql>

    <sql id="columns">
        s.id::text as id, s.name, v.id::text as version_id, v.version_no
    </sql>

    <!-- position 保留空串、大小写无关和字面 %/_ 搜索语义。 -->
    <select id="list" resultMap="clientScene">
        select <include refid="columns" />
        <include refid="visible" />
        and position(lower(#{name}) in lower(s.name))&gt;0
        order by s.name, s.id limit #{limit} offset #{offset}
    </select>

    <select id="count" resultType="long">
        select count(*) <include refid="visible" />
        and position(lower(#{name}) in lower(s.name))&gt;0
    </select>

    <select id="find" resultMap="clientScene">
        select <include refid="columns" />
        <include refid="visible" />
        and s.id=cast(#{sceneId} as uuid)
    </select>

    <select id="files" resultMap="clientFile">
        select id::text as id, relative_path, expected_bytes, expected_sha256
        from ar_version_file
        where version_id=cast(#{versionId} as uuid)
        order by relative_path, id
    </select>
</mapper>
